/- Inductive predicates: ≤ and evenness, built by rules and taken apart by
   their recursors. `Le` and `Even` are Props with more than one rule, so
   their recursors only eliminate into Prop (`Le.rec`, no universe). -/

inductive False : Prop where
inductive True : Prop where
  | intro : True
def Not (A : Prop) : Prop := A → False

inductive Nat : Type where
  | zero : Nat
  | succ (n : Nat) : Nat

inductive Exists (A : Type) (P : A → Prop) : Prop where
  | intro (w : A) (h : P w) : Exists A P

-- n ≤ m, generated by reflexivity and stepping the right-hand side
inductive Le (n : Nat) : Nat → Prop where
  | refl : Le n n
  | step (m : Nat) (h : Le n m) : Le n (Nat.succ m)

inductive Even : Nat → Prop where
  | zero : Even Nat.zero
  | ss (n : Nat) (h : Even n) : Even (Nat.succ (Nat.succ n))

def double (n : Nat) : Nat :=
  Nat.rec.{1} (fun (_ : Nat) => Nat) Nat.zero (fun (k : Nat) (ih : Nat) => Nat.succ (Nat.succ ih)) n

-- `isOne m` computes to True for 1 and False otherwise (large elimination of Nat)
def isZero (n : Nat) : Prop :=
  Nat.rec.{1} (fun (_ : Nat) => Prop) True (fun (k : Nat) (ih : Prop) => False) n
def isOne (n : Nat) : Prop :=
  Nat.rec.{1} (fun (_ : Nat) => Prop) False (fun (k : Nat) (ih : Prop) => isZero k) n

def one : Nat := Nat.succ Nat.zero
def two : Nat := Nat.succ one
def four : Nat := Nat.succ (Nat.succ two)

-- ---- ≤ ----

theorem le_two_four : Le two four :=
  sorry

theorem le_succ : ∀ (n : Nat), Le n (Nat.succ n) :=
  sorry

theorem le_trans : ∀ (a b c : Nat), Le a b → Le b c → Le a c :=
  sorry

theorem zero_le : ∀ (n : Nat), Le Nat.zero n :=
  sorry

-- ---- evenness ----

theorem even_four : Even four := sorry

theorem even_double : ∀ (n : Nat), Even (double n) :=
  sorry

-- inversion: no rule concludes `Even 1`
theorem not_even_one : Not (Even one) :=
  sorry

theorem exists_even : Exists Nat (fun (n : Nat) => Even (Nat.succ (Nat.succ n))) :=
  sorry
